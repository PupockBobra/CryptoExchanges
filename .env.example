# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: service name 'timescaledb' resolves inside Docker network
DATABASE_URL=postgresql://arbi:arbi@timescaledb:5432/arbidb
# Production: use a strong password; must match POSTGRES_PASSWORD below
# DATABASE_URL=postgresql://arbi:<strong-password>@timescaledb:5432/arbidb
POSTGRES_PASSWORD=arbi   # CHANGE THIS in production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Arbitrage ─────────────────────────────────────────────────────────────────
ARBI_THRESHOLD_PCT=0.3
# Spot pairs + USDT-margined perpetuals (symbol:USDT = perp future)
ARBI_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XAU/USDT:USDT,XAG/USDT:USDT,XPT/USDT:USDT,XPD/USDT:USDT,BRN/USDT:USDT,NATGAS/USDT:USDT,NVDA/USDT:USDT,QQQ/USDT:USDT,SPY/USDT:USDT,TSLA/USDT:USDT

# Optional per-exchange symbol overrides (JSON).
# Use when an exchange lists a pair under a different ccxt unified name.
# Format: {"canonical_symbol": {"exchange_id": "exchange_symbol"}}
SYMBOL_ALIASES={}

# ── Frontend (baked into JS bundle at build time by Vite) ─────────────────────
# Local dev: leave empty (defaults to same-origin)
VITE_API_URL=
# Production: set to your full domain, e.g. https://arbi.yourdomain.com
# VITE_API_URL=https://arbi.yourdomain.com
VITE_ARBI_THRESHOLD=0.3

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev
CORS_ORIGINS=http://localhost:5173
# Production: set to your domain
# CORS_ORIGINS=https://arbi.yourdomain.com

# ── Exchange API keys (optional — public ticker feeds work without keys) ──────
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_SECRET=
MEXC_API_KEY=
MEXC_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
