# ── Database ─────────────────────────────────────────────────────────────────
# Production: set both DATABASE_URL password AND POSTGRES_PASSWORD to the same
# strong value. They MUST match — Postgres is initialized from POSTGRES_PASSWORD,
# the backend connects via DATABASE_URL.
DATABASE_URL=postgresql://arbi:CHANGE_ME_STRONG_PASSWORD@timescaledb:5432/arbidb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Local dev only (uncomment, override the two lines above):
# DATABASE_URL=postgresql://arbi:arbi@timescaledb:5432/arbidb
# POSTGRES_PASSWORD=arbi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Arbitrage ─────────────────────────────────────────────────────────────────
ARBI_THRESHOLD_PCT=0.3
# Spot pairs + USDT-margined perpetuals (symbol:USDT = perp future)
ARBI_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XAU/USDT:USDT,XAG/USDT:USDT,XPT/USDT:USDT,XPD/USDT:USDT,BRN/USDT:USDT,WTI/USDT:USDT,NATGAS/USDT:USDT,NVDA/USDT:USDT,QQQ/USDT:USDT,SPY/USDT:USDT,TSLA/USDT:USDT

# Optional per-exchange symbol overrides (JSON).
# Use when an exchange lists a pair under a different ccxt unified name.
# Format: {"canonical_symbol": {"exchange_id": "exchange_symbol"}}
SYMBOL_ALIASES={}

# ── Frontend (baked into JS bundle at build time by Vite) ─────────────────────
# Production: full HTTPS domain
VITE_API_URL=https://YOUR_DOMAIN
# Local dev: leave empty (defaults to same-origin)
# VITE_API_URL=
VITE_ARBI_THRESHOLD=0.3

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: set to your domain (comma-separated for multiple)
CORS_ORIGINS=https://YOUR_DOMAIN
# Local dev:
# CORS_ORIGINS=http://localhost:5173

# ── Exchange API keys (optional — public ticker feeds work without keys) ──────
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_SECRET=
MEXC_API_KEY=
MEXC_SECRET=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

# ── Finam TradeAPI (SPB Exchange perp turnover) ───────────────────────────────
# Secret token (tapi_sk_…) used by the SPB ETL to fetch СПБ Биржа perp volumes.
# Backend-only: it grants READ access to the owner's brokerage account (trades,
# money movements, balance), so it must never be exposed to the frontend.
# Leave blank to disable the SPB Volume page (ETL becomes a no-op).
FINAM_API_TOKEN=

# ── Telegram (SPB funding auto-ingest from @beststocks_neo) ───────────────────
# api_id / api_hash come from https://my.telegram.org → API development tools.
# Auto-ingest needs a USER session (a bot cannot read a channel it doesn't
# administer), created once with:
#   docker compose exec backend python -m app.spb.funding_tg login
# ⚠️ The session file grants FULL access to that Telegram account — use a
# throwaway account, keep the file out of git, mount it read-write at runtime.
# Leave the id/hash blank to disable the loop (the manual upload page still works).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/data/telegram/spb_funding.session
TELEGRAM_FUNDING_CHANNEL=beststocks_neo

# ── MOEX ISS proxy ────────────────────────────────────────────────────────────
# Required when the server IP is geo-blocked by MOEX (non-RU hosting).
# Without it, MOEX ETL logs warnings and skips — the app still runs.
# MOEX_ISS_PROXY=socks5://user:pass@ru-proxy-host:1080

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
